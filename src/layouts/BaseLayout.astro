---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Dark header that blends into a dark hero (homepage). */
  darkHeader?: boolean;
}

const {
  title,
  description = 'Product leader and AI builder testing how AI changes product development, what one person can build, and where faster execution still breaks.',
  ogImage = '/images/og-default.jpg',
  darkHeader = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header
      class:list={[
        'sticky top-0 z-50 backdrop-blur-sm border-b',
        darkHeader ? 'bg-gray-900/95 border-gray-800' : 'bg-white/80 border-gray-100',
      ]}
    >
      <nav class:list={['py-4 flex items-center justify-between', darkHeader ? 'max-w-6xl mx-auto px-6' : 'section-container']}>
        <a
          href="/"
          class:list={[
            'font-semibold text-lg transition-colors',
            darkHeader ? 'text-white hover:text-accent-400' : 'text-gray-900 hover:text-accent-600',
          ]}
        >
          Kyle McLeod
        </a>
        <ul class:list={['flex items-center gap-8 text-sm font-medium', darkHeader ? 'text-gray-300' : 'text-gray-700']}>
          <li><a href="/work" class:list={['transition-colors', darkHeader ? 'hover:text-white' : 'hover:text-gray-900']}>Work</a></li>
          <li><a href="/blog" class:list={['transition-colors', darkHeader ? 'hover:text-white' : 'hover:text-gray-900']}>Blog</a></li>
          <li>
            <a
              href="https://www.linkedin.com/in/kyle--mcleod/"
              target="_blank"
              rel="noopener"
              class:list={[darkHeader ? 'text-accent-400 hover:text-accent-200 transition-colors' : 'btn-primary px-4 py-2']}
            >
              LinkedIn →
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-gray-100 py-10 mt-20">
      <div class="section-container flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500">
        <p>&copy; {new Date().getFullYear()} Kyle McLeod. All rights reserved.</p>
        <div class="flex items-center gap-6">
          <a href="https://www.linkedin.com/in/kyle--mcleod/" target="_blank" rel="noopener" class="hover:text-gray-900 transition-colors">LinkedIn</a>
        </div>
      </div>
    </footer>
  </body>
</html>
