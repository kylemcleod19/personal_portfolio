---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Product leader and AI builder testing how AI changes product development, what one person can build, and where faster execution still breaks.',
  ogImage = '/images/og-default.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/blog', label: 'Writing' },
];
const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 h-[61px] bg-gray-900/95 backdrop-blur-sm border-b border-gray-800">
      <nav class="max-w-6xl mx-auto px-6 h-full flex items-center justify-between">
        <a href="/" class="font-semibold text-lg text-white hover:text-accent-400 transition-colors">
          Kyle McLeod
        </a>
        <ul class="flex items-center gap-8 text-sm font-medium text-gray-300">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={['transition-colors hover:text-white', isActive(link.href) && 'text-white font-semibold']}
              >
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a
              href="https://www.linkedin.com/in/kyle--mcleod/"
              target="_blank"
              rel="noopener"
              class="text-accent-400 hover:text-accent-200 transition-colors"
            >
              LinkedIn →
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-gray-900">
      <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400">
        <p class="text-gray-400">&copy; {new Date().getFullYear()} Kyle McLeod</p>
        <a
          href="https://www.linkedin.com/in/kyle--mcleod/"
          target="_blank"
          rel="noopener"
          class="text-accent-400 hover:text-accent-200 transition-colors"
        >
          LinkedIn →
        </a>
      </div>
    </footer>
  </body>
</html>
