---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Blog — Your Name" description="Thoughts on product management, leadership, and building software.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Blog</h1>
      <p class="page-lead">Thoughts on product management, leadership, and building software.</p>
    </div>

    {posts.length === 0 ? (
      <p class="text-gray-500">No posts yet — check back soon.</p>
    ) : (
      <ul class="flex flex-col gap-6">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="group flex gap-5 items-start card-ink-edge writing-card">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap gap-2 mb-2">
                  {post.data.tags.map((tag) => (
                    <span class="tag-label">{tag}</span>
                  ))}
                </div>
                <h2 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-accent-600 transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-gray-600 text-sm mb-3">{post.data.description}</p>
                <time class="text-xs text-gray-500">{fmt(post.data.pubDate)}</time>
              </div>
              {post.data.cover && (
                <img
                  src={post.data.cover}
                  alt=""
                  width="112"
                  height="112"
                  loading="lazy"
                  class="w-20 h-20 sm:w-28 sm:h-28 shrink-0 rounded-lg border border-gray-100 bg-gray-50 p-1.5"
                />
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
