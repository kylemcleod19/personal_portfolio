---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import WritingIndex from '../../components/WritingIndex.tsx';
import type { WritingPost } from '../../components/WritingIndex.tsx';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const buildTitles = (await getCollection('work'))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  .map((w) => w.data.title);

const writingPosts: WritingPost[] = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  href: `/blog/${post.slug}`,
  month: post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }),
  day: String(post.data.pubDate.getUTCDate()).padStart(2, '0'),
  thread: post.data.thread,
}));
---

<BaseLayout title="Writing" description="Notes from the experimentation loop: industry signals, what I'm building, and how I work with AI tools.">
  <WritingIndex client:load posts={writingPosts} buildTitles={buildTitles} />
</BaseLayout>
