---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HeroTerminal from '../components/HeroTerminal.tsx';
import CompanyLogos from '../components/CompanyLogos.tsx';
import ExperimentLoop from '../components/ExperimentLoop.tsx';
import type { LoopItem, LoopThread, Thumb } from '../components/ExperimentLoop.tsx';

const workEntries = (await getCollection('work'))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Posts about method go under "How I practice"; everything else is a signal.
const practiceSlugs = new Set(['tools-idea-to-working-software']);

// Homepage-only presentation for each build: list thumbnail and status label.
const buildDisplay: Record<string, { meta: string; thumb: Thumb }> = {
  'catch-ai': { meta: 'Live', thumb: { kind: 'screen', src: '/images/work/Catch App Home.png', alt: 'catch.ai home screen' } },
  'sample-erp': { meta: 'Live', thumb: { kind: 'stat', value: '8', label: 'modules' } },
  'erpforge': { meta: 'Working demo', thumb: { kind: 'cover', src: '/images/work/ERPForge - BOM.png', alt: 'ERPForge BOM screen' } },
};

const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const day = (d: Date) => String(d.getUTCDate()).padStart(2, '0');
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

const buildItems: LoopItem[] = workEntries.map((entry) => {
  const display = buildDisplay[entry.slug];
  return {
    title: entry.data.title,
    blurb: entry.data.learningQuestion ?? entry.data.description,
    href: `/work/${entry.slug}`,
    meta: display?.meta ?? 'Build',
    thumb: display?.thumb ?? (entry.data.cover
      ? { kind: 'cover', src: entry.data.cover, alt: entry.data.title }
      : { kind: 'date', month: monthYear(entry.data.pubDate), day: day(entry.data.pubDate) }),
  };
});

const postItem = (post: (typeof posts)[number]): LoopItem => ({
  title: post.data.title,
  blurb: post.data.description,
  href: `/blog/${post.slug}`,
  meta: 'Essay',
  thumb: { kind: 'date', month: monthYear(post.data.pubDate), day: day(post.data.pubDate) },
});
const signalItems = posts.filter((p) => !practiceSlugs.has(p.slug)).map(postItem);
const practiceItems = posts.filter((p) => practiceSlugs.has(p.slug)).map(postItem);

const threads: LoopThread[] = [
  {
    key: 'building',
    label: 'What I am building',
    context: 'Real software, built with AI tools, to test whether the argument holds.',
    count: plural(buildItems.length, 'build'),
    items: buildItems,
    allHref: '/work',
    allLabel: 'All work',
  },
  {
    key: 'signals',
    label: 'Industry signals and thoughts',
    context: 'What cheaper software does to moats, markets and who gets to build.',
    count: plural(signalItems.length, 'essay'),
    items: signalItems,
    allHref: '/blog',
    allLabel: 'All writing',
  },
  {
    key: 'practice',
    label: 'How I practice',
    context: 'How I scope, prompt, review and ship with AI tools, day to day.',
    count: plural(practiceItems.length, 'post'),
    items: practiceItems,
    allHref: '/blog',
    allLabel: 'All writing',
  },
];
---

<BaseLayout title="Kyle McLeod · Product Leader & AI Builder" darkHeader>
  <!-- Hero -->
  <section class="bg-gray-900">
    <div class="max-w-6xl mx-auto px-6 pt-12 pb-16 md:pt-14 md:pb-16 grid md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] gap-14 items-center">
      <div class="flex flex-col gap-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">Product Leader · AI Builder</p>
        <h1 class="text-[40px] sm:text-5xl lg:text-[56px] leading-[1.02] font-extrabold tracking-[-0.04em] text-white text-balance">
          The cost of building software has collapsed. <span class="text-accent-400">I’m testing what that changes.</span>
        </h1>
        <p class="text-lg leading-relaxed text-gray-200 max-w-[520px] text-pretty">
          I build real software with AI tools, then write about what it shows.
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4 pt-2">
          <a
            href="/work"
            class="bg-white text-gray-900 rounded-lg font-medium px-6 py-3 hover:bg-accent-100 transition-colors"
          >
            Explore the builds →
          </a>
          <a
            href="https://www.linkedin.com/in/kyle--mcleod/"
            target="_blank"
            rel="noopener"
            class="text-gray-300 font-medium hover:text-white transition-colors"
          >
            Read what I'm learning →
          </a>
        </div>
      </div>
      <div class="hidden md:block">
        <HeroTerminal client:load />
      </div>
    </div>
  </section>

  <!-- Experimentation loop -->
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-12">
    <ExperimentLoop client:load threads={threads} />
  </section>

  <!-- About strip -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-3xl font-extrabold tracking-[-0.03em] text-gray-900 mb-4">About me</h2>
      <div class="max-w-3xl">
        <p class="text-gray-700 leading-relaxed mb-4">
          I’m a product and strategy leader with a background in manufacturing, marketplaces, decision systems, and complex operational software.
        </p>
        <p class="text-gray-700 leading-relaxed mb-4">
          After leading product at MacroFab, I began building applications with AI coding tools and testing how they change the path from product idea to working software. I’ve since applied those methods to personal builds and consulting work through Kedge Capital Partners.
        </p>
        <p class="text-gray-700 leading-relaxed mb-4">
          This site is where I document the experiments, what they appear to show, and the parts that remain harder than expected.
        </p>
        <p class="text-gray-700 leading-relaxed">
          When I'm not building, I'm probably fly fishing.
        </p>
      </div>
      <div class="mt-10 pt-8 border-t border-gray-200">
        <CompanyLogos client:load />
      </div>
    </div>
  </section>
</BaseLayout>
